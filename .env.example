# ─── AI 网关（一键部署到 Makers 时自动注入，本地开发需自己取 Key）───────────
# 控制台 → Makers → Models → API Key
AI_GATEWAY_API_KEY=your-api-key
AI_GATEWAY_BASE_URL=https://ai-gateway.edgeone.link/v1

# 模板代码里的默认值是 @makers/hy3-preview，文档写的是 deepseek-v3。
# 这里显式写死，避免模板更新后模型悄悄变化。
AI_GATEWAY_MODEL=@makers/deepseek-v3

# ─── 全站文章索引（跨文章检索用）───────────────────────────────────────────
# 指向博客域名。/ai-index.json 与 /ai/<id>.json 由 Hexo 构建时生成，
# 需要在博客的 edgeone.json 里给这些路径开 CORS。
DATA_API_BASE_URL=https://blog.liliee.cn

# ─── 公开域防护 ────────────────────────────────────────────────────────────
# 绑定自定义域名后 /chat 对公网无鉴权，靠下面几项挡滥用。
# 换成你实际绑定的域名时，两个域都要改：博客域（宿主）和助手域（iframe 同源）。
ALLOWED_ORIGINS=https://blog.liliee.cn,https://chat.liliee.cn,http://localhost:8088,http://127.0.0.1:8088

# 每 IP 每分钟请求数 / 每会话每分钟请求数 / 单实例每日总请求数 / 单次提问最大字数
RATE_PER_MINUTE_IP=12
RATE_PER_MINUTE_CONV=20
RATE_PER_DAY=500
MAX_MESSAGE_CHARS=2000
